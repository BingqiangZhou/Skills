# Unified runtime workspaces: everything (collector middleware, batch/narrative
# intermediates, and the finished daily-digests/ + journals/ outputs) lives
# under workspaces/. Keep the directory itself tracked via .gitkeep, but
# ignore all runtime contents.
workspaces/*
!workspaces/.gitkeep
.vscode/
# Ignore all of .zcode/ except the tracked release skill (shared via git).
# Per git's rules, each level must be un-ignored to descend into it.
.zcode/*
!.zcode/skills/
.zcode/skills/*
!.zcode/skills/release/
__pycache__/

# Runtime caches that may land inside plugin references/
.feed_list_cache.json

# Script-generated data snapshots (regenerated on first run, not hand-curated):
#   feeds_wechat.json — fetched weekly by rss-monitor/scripts/fetch_feed_list.py
#   podcasts.json     — fetched weekly by rss-monitor/scripts/fetch_podcast_list.py
plugins/daily-digest/skills/rss-monitor/references/feeds_wechat.json
plugins/daily-digest/skills/rss-monitor/references/podcasts.json

# Derived debug renderings (podcasts.json as Markdown — pure artifact)
podcast_rss_list.md

# Local notes/docs (not part of the distributed plugin)
docs/

# Workspace-local agent instructions (generated by /init, not distributed)
AGENTS.md